# =========================================
# Cluster Aliases Definition
# =========================================
clusters = {{ kafka_mm2_source_cluster }},{{ kafka_mm2_target_cluster }}

# =========================================
# Source Cluster Configuration
# =========================================
{{ kafka_mm2_source_cluster }}.bootstrap.servers = {{ kafka_mm2_source_bootstrap_servers }}
{% if kafka_mm2_source_security_protocol | default(false) %}
{{ kafka_mm2_source_cluster }}.security.protocol = {{ kafka_mm2_source_security_protocol }}
{% endif %}
{% if kafka_mm2_source_sasl_mechanism | default(false) %}
{{ kafka_mm2_source_cluster }}.sasl.mechanism = {{ kafka_mm2_source_sasl_mechanism }}
{% endif %}
{% if kafka_mm2_source_sasl_jaas_config | default(false) %}
{{ kafka_mm2_source_cluster }}.sasl.jaas.config = {{ kafka_mm2_source_sasl_jaas_config }}
{% endif %}

# =========================================
# Target Cluster Configuration
# =========================================
{{ kafka_mm2_target_cluster }}.bootstrap.servers = {{ kafka_mm2_target_bootstrap_servers }}
{% if kafka_mm2_target_security_protocol | default(false) %}
{{ kafka_mm2_target_cluster }}.security.protocol = {{ kafka_mm2_target_security_protocol }}
{% endif %}
{% if kafka_mm2_target_sasl_mechanism | default(false) %}
{{ kafka_mm2_target_cluster }}.sasl.mechanism = {{ kafka_mm2_target_sasl_mechanism }}
{% endif %}
{% if kafka_mm2_target_sasl_jaas_config | default(false) %}
{{ kafka_mm2_target_cluster }}.sasl.jaas.config = {{ kafka_mm2_target_sasl_jaas_config }}
{% endif %}
{% if kafka_mm2_target_ssl_truststore_location | default(false) %}
{{ kafka_mm2_target_cluster }}.ssl.truststore.location = {{ kafka_mm2_target_ssl_truststore_location }}
{% endif %}
{% if kafka_mm2_target_ssl_endpoint_algorithm | default(false) %}
{{ kafka_mm2_target_cluster }}.ssl.endpoint.identification.algorithm = {{ kafka_mm2_target_ssl_endpoint_algorithm }}
{% endif %}

# =========================================
# Replication Flow: source -> target
# =========================================
{{ kafka_mm2_source_cluster }}->{{ kafka_mm2_target_cluster }}.enabled = {{ kafka_mm2_replication_enabled | default('true') }}
{{ kafka_mm2_source_cluster }}->{{ kafka_mm2_target_cluster }}.topics = {{ kafka_mm2_topics_pattern }}
{{ kafka_mm2_source_cluster }}->{{ kafka_mm2_target_cluster }}.topics.exclude = {{ kafka_mm2_topics_exclude | default('^__.*') }}
{{ kafka_mm2_source_cluster }}->{{ kafka_mm2_target_cluster }}.replication.factor = {{ kafka_mm2_replication_factor }}
{{ kafka_mm2_source_cluster }}->{{ kafka_mm2_target_cluster }}.producer.enable.idempotence = true
{{ kafka_mm2_source_cluster }}->{{ kafka_mm2_target_cluster }}.producer.acks = all

# =========================================
# Disable Reverse Replication
# =========================================
{{ kafka_mm2_target_cluster }}->{{ kafka_mm2_source_cluster }}.enabled = false

# =========================================
# Replication Policy (Topic Name Mapping)
# =========================================
# IdentityReplicationPolicy: keeps original topic names (my-topic -> my-topic)
replication.policy.class = org.apache.kafka.connect.mirror.IdentityReplicationPolicy
replication.policy.separator = .

# =========================================
# Global Configuration
# =========================================
tasks.max = {{ kafka_mm2_tasks_max | default('3') }}
group.id = {{ kafka_mm2_group_id | default('mm2-mirror-maker') }}

# Disable topic config and ACL sync
sync.topic.configs.enabled = {{ kafka_mm2_sync_topic_configs | default('false') }}
sync.topic.acls.enabled = {{ kafka_mm2_sync_topic_acls | default('false') }}

# Enable checkpoints for consumer offset sync
emit.checkpoints.enabled = {{ kafka_mm2_emit_checkpoints | default('true') }}

# =========================================
# Internal Topics Replication Factors
# =========================================
replication.factor = {{ kafka_mm2_replication_factor }}
checkpoints.topic.replication.factor = {{ kafka_mm2_replication_factor }}
heartbeats.topic.replication.factor = {{ kafka_mm2_replication_factor }}
offset-syncs.topic.replication.factor = {{ kafka_mm2_replication_factor }}

# =========================================
# Connector Configuration
# =========================================
connector.client.config.override.policy = All

# =========================================
# Consumer Tuning (Source)
# =========================================
{{ kafka_mm2_source_cluster }}.consumer.fetch.max.bytes = {{ kafka_mm2_consumer_fetch_max_bytes | default('67108864') }}
{{ kafka_mm2_source_cluster }}.consumer.max.partition.fetch.bytes = {{ kafka_mm2_consumer_max_partition_fetch_bytes | default('67108864') }}
{{ kafka_mm2_source_cluster }}.consumer.max.poll.records = {{ kafka_mm2_consumer_max_poll_records | default('5000') }}
{{ kafka_mm2_source_cluster }}.consumer.group.id = {{ kafka_mm2_consumer_group_id | default('mm2-checkpoint-consumer') }}
{{ kafka_mm2_source_cluster }}.consumer.session.timeout.ms = {{ kafka_mm2_consumer_session_timeout | default('60000') }}
{{ kafka_mm2_source_cluster }}.consumer.request.timeout.ms = {{ kafka_mm2_consumer_request_timeout | default('120000') }}
{{ kafka_mm2_source_cluster }}.consumer.auto.offset.reset = {{ kafka_mm2_consumer_auto_offset_reset | default('earliest') }}

# =========================================
# Producer Performance Optimization (Target)
# =========================================
producer.batch.size = {{ kafka_mm2_producer_batch_size | default('16384') }}
producer.linger.ms = {{ kafka_mm2_producer_linger_ms | default('1') }}
producer.enable.idempotence = true
producer.override.acks = all
producer.override.retries = {{ kafka_mm2_producer_retries | default('10') }}
producer.override.delivery.timeout.ms = {{ kafka_mm2_producer_delivery_timeout | default('120000') }}
producer.override.compression.type = {{ kafka_mm2_producer_compression_type | default('snappy') }}
producer.override.max.request.size = {{ kafka_mm2_producer_max_request_size | default('67108864') }}

# =========================================
# REST API Settings
# =========================================
rest.port={{ kafka_mm2_port }}
rest.host.name={{ 'api' | kolla_address }}
rest.advertised.host.name={{ 'api' | kolla_address }}
rest.advertised.port={{ kafka_mm2_port }}

# =========================================
# Additional Settings
# =========================================
metric.reporters =

