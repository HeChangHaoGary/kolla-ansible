#
# This configuration file is auto-generated by Kolla-Ansible
#

# This is a configuration for Kafka Connect in distributed mode

####################
# Bootstrap Servers
####################
bootstrap.servers={{ kafka_broker_bootstrap_servers }}

####################
# Group ID
####################
group.id={{ kafka_connect_group_id | default('connect-cluster') }}

####################
# Converter Settings
####################
# Converter for keys
key.converter=org.apache.kafka.connect.json.JsonConverter
key.converter.schemas.enable={{ kafka_connect_key_converter_schemas_enable | default('true') }}

# Converter for values
value.converter=org.apache.kafka.connect.json.JsonConverter
value.converter.schemas.enable={{ kafka_connect_value_converter_schemas_enable | default('true') }}

####################
# Internal Topics
####################
# Topic to use for storing connector and task configurations
config.storage.topic={{ kafka_connect_config_storage_topic | default('connect-configs') }}
config.storage.replication.factor={{ kafka_connect_config_storage_replication_factor | default('3') }}

# Topic to use for storing connector and task status updates
status.storage.topic={{ kafka_connect_status_storage_topic | default('connect-status') }}
status.storage.replication.factor={{ kafka_connect_status_storage_replication_factor | default('3') }}

# Topic to use for storing offsets
offset.storage.topic={{ kafka_connect_offset_storage_topic | default('connect-offsets') }}
offset.storage.replication.factor={{ kafka_connect_offset_storage_replication_factor | default('3') }}
offset.storage.partitions={{ kafka_connect_offset_storage_partitions | default('25') }}

# Timeout used to detect worker failures
session.timeout.ms={{ kafka_connect_session_timeout_ms | default('10000') }}

####################
# REST API Settings
####################
# REST API port
rest.port={{ kafka_connect_port }}

# Hostname for REST API
rest.host.name={{ 'api' | kolla_address }}

# Advertised hostname (used for inter-worker communication)
rest.advertised.host.name={{ 'api' | kolla_address }}
rest.advertised.port={{ kafka_connect_port }}

####################
# Plugin Path
####################
# Set of paths separated by commas that contain plugins (connectors, converters, transformations)
plugin.path=/opt/kafka/plugins,/usr/share/java

####################
# Producer Settings
####################
producer.compression.type=snappy
producer.max.request.size=10485760

####################
# Consumer Settings
####################
consumer.max.poll.records=500
consumer.max.partition.fetch.bytes=10485760

####################
# Custom Settings
####################
{% if kafka_connect_custom_config | default(false) %}
{{ kafka_connect_custom_config }}
{% endif %}
