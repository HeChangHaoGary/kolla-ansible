# This configuration file is auto-generated by Kolla-Ansible
#

############################# Server Basics #############################

# The id of the broker. This must be set to a unique integer for each broker.
{% if kafka_kraft_mode | bool %}
node.id={{ kafka_broker_id }}
process.roles=broker,controller
{% else %}
broker.id={{ kafka_broker_id }}
{% endif %}

############################# Socket Server Settings #############################

# The address the socket server listens on. It will get the value returned from
# java.net.InetAddress.getCanonicalHostName() if not configured.
#   FORMAT:
#     listeners = listener_name://host_name:port
#   EXAMPLE:
#     listeners = PLAINTEXT://your.host.name:9092
{% if kafka_kraft_mode | bool %}
listeners=PLAINTEXT://{{ 'api' | kolla_address }}:{{ kafka_port }},CONTROLLER://{{ 'api' | kolla_address }}:9093
advertised.listeners=PLAINTEXT://{{ 'api' | kolla_address }}:{{ kafka_port }}
listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,SSL:SSL,SASL_PLAINTEXT:SASL_PLAINTEXT,SASL_SSL:SASL_SSL
{% else %}
listeners=PLAINTEXT://{{ 'api' | kolla_address }}:{{ kafka_port }}
advertised.listeners=PLAINTEXT://{{ 'api' | kolla_address }}:{{ kafka_port }}
{% endif %}

# Maps listener names to security protocols, the default is for them to be the same. See the config documentation for more details
#listener.security.protocol.map=PLAINTEXT:PLAINTEXT,SSL:SSL,SASL_PLAINTEXT:SASL_PLAINTEXT,SASL_SSL:SASL_SSL

# The number of threads that the server uses for receiving requests from the network and sending responses to the network
num.network.threads=3

# The number of threads that the server uses for processing requests, which may include disk I/O
num.io.threads=8

# The send buffer (SO_SNDBUF) used by the socket server
socket.send.buffer.bytes=102400

# The receive buffer (SO_RCVBUF) used by the socket server
socket.receive.buffer.bytes=102400

# The maximum size of a request that the socket server will accept (protection against OOM)
socket.request.max.bytes=104857600

############################# Log Basics #############################

# A comma separated list of directories under which to store log files
log.dirs=/var/lib/kafka/data

# The default number of log partitions per topic.
num.partitions=1

# The number of threads per data directory to be used for log recovery at startup and flushing at shutdown.
num.recovery.threads.per.data.dir=1

############################# Internal Topic Settings  #############################

# The replication factor for the group metadata internal topics "__consumer_offsets" and "__transaction_state"
offsets.topic.replication.factor={{ kafka_offsets_topic_replication_factor }}
transaction.state.log.replication.factor={{ kafka_transaction_state_log_replication_factor }}
transaction.state.log.min.isr={{ kafka_transaction_state_log_min_isr }}

############################# Log Flush Policy #############################

# Messages are immediately written to the filesystem but by default we only fsync() to sync
# the OS cache lazily. The following configurations control the flush of data to disk.

# The number of messages to accept before forcing a flush of data to disk
#log.flush.interval.messages=10000

# The maximum amount of time a message can sit in a log before we force a flush
#log.flush.interval.ms=1000

############################# Log Retention Policy #############################

# The minimum age of a log file to be eligible for deletion due to age
log.retention.hours={{ kafka_log_retention_hours }}

# A size-based retention policy for logs.
log.retention.bytes={{ kafka_log_retention_bytes }}

# The maximum size of a log segment file. When this size is reached a new log segment will be created.
log.segment.bytes={{ kafka_log_segment_bytes }}

# The interval at which log segments are checked to see if they can be deleted according
# to the retention policies
log.retention.check.interval.ms=300000

############################# Zookeeper (if not using KRaft) #############################

{% if not kafka_kraft_mode | bool %}
# Zookeeper connection string
zookeeper.connect={{ kafka_zookeeper_connect }}

# Timeout in ms for connecting to zookeeper
zookeeper.connection.timeout.ms=18000
{% endif %}

############################# KRaft Settings (Kafka 3.0+) #############################

{% if kafka_kraft_mode | bool %}
# The cluster id
#cluster.id={{ kafka_cluster_id }}

# Controller quorum voters
controller.quorum.voters={{ kafka_controller_quorum_voters }}

# Metadata log directory
metadata.log.dir=/var/lib/kafka/data/__cluster_metadata
{% endif %}

############################# Group Coordinator Settings #############################

# The following configuration specifies the time, in milliseconds, that the GroupCoordinator will delay the initial consumer rebalance.
group.initial.rebalance.delay.ms=0

############################# Replication Settings #############################

# The default replication factors for automatically created topics
default.replication.factor={{ kafka_default_replication_factor }}

# When a producer sets acks to "all" (or "-1"), min.insync.replicas specifies the minimum number of replicas that
# must acknowledge a write for the write to be considered successful.
min.insync.replicas={{ kafka_min_insync_replicas }}

############################# Performance Tuning #############################

# Increase the number of replica fetcher threads
num.replica.fetchers=4

# Enable compression
compression.type=snappy

# Increase socket buffer sizes for better network throughput
replica.socket.receive.buffer.bytes=65536

############################# Security Settings #############################

{% if kafka_enable_sasl | default(false) %}
# SASL Configuration
sasl.enabled.mechanisms={{ kafka_sasl_mechanism | default('PLAIN') }}
sasl.mechanism.inter.broker.protocol={{ kafka_sasl_mechanism | default('PLAIN') }}
security.inter.broker.protocol={{ kafka_security_protocol | default('SASL_PLAINTEXT') }}
{% endif %}

{% if kafka_enable_ssl | default(false) %}
# SSL Configuration
ssl.keystore.location={{ kafka_ssl_keystore_location }}
ssl.keystore.password={{ kafka_ssl_keystore_password }}
ssl.key.password={{ kafka_ssl_key_password }}
ssl.truststore.location={{ kafka_ssl_truststore_location }}
ssl.truststore.password={{ kafka_ssl_truststore_password }}
ssl.client.auth={{ kafka_ssl_client_auth | default('none') }}
{% endif %}

############################# Custom Settings #############################

{% if kafka_custom_config | default(false) %}
{{ kafka_custom_config }}
{% endif %}
